# Development Environment Variables for CityPulse Frontend
# This file is used when running the frontend in development mode

# Backend API URL - Change this to match your backend server
# For Docker development setup (all services in containers)
VITE_API_URL=http://localhost:5001

# Alternative configurations (uncomment as needed):
# For local development (backend running locally on different port)
# VITE_API_URL=http://localhost:5000

# For production or different environment
# VITE_API_URL=https://api.citypulse.com

# Application Environment
VITE_APP_ENV=development

# Enable debug logging
VITE_DEBUG=true