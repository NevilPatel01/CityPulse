# Development Dockerfile for Frontend
FROM node:20-alpine

# Install pnpm
RUN corepack enable pnpm

# Create workspace directory and set permissions
RUN mkdir -p /workspace && chown -R node:node /workspace

WORKDIR /workspace

# Copy workspace configuration and package files first for better caching
COPY --chown=node:node package.json pnpm-workspace.yaml pnpm-lock.yaml ./
COPY --chown=node:node shared/package.json ./shared/package.json
COPY --chown=node:node frontend/package.json ./frontend/package.json

# Install dependencies first (this layer will be cached if package.json doesn't change)
RUN pnpm install --frozen-lockfile

# Copy source code
COPY --chown=node:node shared/ ./shared/
COPY --chown=node:node frontend/ ./frontend/

# Create mount directories with proper permissions
RUN mkdir -p /workspace/frontend/src /workspace/frontend/public /workspace/shared/src && \
    chown -R node:node /workspace

# Switch to non-root user
USER node

WORKDIR /workspace/frontend

EXPOSE 3000

# Start development server with hot reload
CMD ["pnpm", "run", "dev"]
