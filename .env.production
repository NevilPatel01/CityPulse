# CityPulse Production Environment Variables
# This file should exist on your server at /opt/citypulse/.env.production

# Database Configuration
POSTGRES_DB=citypulse_prod
POSTGRES_USER=citypulse_user
POSTGRES_PASSWORD=your_secure_password_here

# JWT Configuration
JWT_SECRET=your_jwt_secret_here
JWT_REFRESH_SECRET=your_jwt_refresh_secret_here

# Google OAuth Configuration
GOOGLE_CLIENT_ID=your_google_client_id_here
GOOGLE_CLIENT_SECRET=your_google_client_secret_here

# Email Configuration
# Note: DigitalOcean blocks ports 25, 465, and 587 by default
# Use port 2525 with STARTTLS-compatible SMTP services
# Recommended providers: SendGrid, Mailgun, AWS SES, or Gmail with proper setup
# For Gmail: Use App Password (not regular password) from Google Account settings
EMAIL_HOST=smtp.gmail.com
EMAIL_PORT=2525
EMAIL_SECURE=false
EMAIL_USER=your_email@gmail.com
EMAIL_PASS=your_email_app_password

# Application URLs
FRONTEND_URL=https://city-pulse.app
VITE_API_URL=https://api.city-pulse.app
VITE_GOOGLE_CLIENT_ID=your_google_client_id_here
VITE_GOOGLE_REDIRECT_URI=https://city-pulse.app/auth/callback
