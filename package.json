{
    "name": "citypulse-travel-platform",
    "version": "1.0.0",
    "description": "CityPulse - Travel Social Network Platform",
    "private": true,
    "scripts": {
        "dev": "concurrently \"pnpm run dev:backend\" \"pnpm run dev:frontend\"",
        "dev:frontend": "pnpm --filter frontend dev",
        "dev:backend": "pnpm --filter backend dev",
        "build": "pnpm run build:frontend && pnpm run build:backend",
        "build:frontend": "pnpm --filter frontend build",
        "build:backend": "pnpm --filter backend build",
        "lint": "pnpm run lint:frontend && pnpm run lint:backend",
        "lint:frontend": "pnpm --filter frontend lint",
        "lint:backend": "pnpm --filter backend lint",
        "lint:fix": "pnpm run lint:fix:frontend && pnpm run lint:fix:backend",
        "lint:fix:frontend": "pnpm --filter frontend lint:fix",
        "lint:fix:backend": "pnpm --filter backend lint:fix",
        "docker:dev": "docker-compose -f docker-compose.dev.yml up --build",
        "docker:dev:down": "docker-compose -f docker-compose.dev.yml down",
        "docker:prod": "docker-compose -f docker-compose.prod.yml up --build -d",
        "docker:prod:down": "docker-compose -f docker-compose.prod.yml down",
        "docker:clean": "docker system prune -f"
    },
    "keywords": [
        "travel",
        "social-network",
        "react",
        "nodejs",
        "postgresql"
    ],
    "author": "CityPulse Team",
    "license": "MIT",
    "packageManager": "pnpm@10.10.0",
    "dependencies": {
        "@sendgrid/mail": "^8.1.6"
    }
}