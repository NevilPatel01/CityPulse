{
  "name": "@citypulse/backend",
  "version": "1.0.0",
  "description": "CityPulse backend API server",
  "main": "dist/index.js",
  "scripts": {
    "dev": "tsx watch src/index.ts",
    "build": "tsc",
    "start": "node dist/index.js",
    "test": "jest",
    "test:unit": "./test-runner.sh",
    "test:watch": "jest --watch",
    "test:coverage": "jest --coverage",
    "test:ci": "jest --ci --coverage --watchAll=false",
    "test:validation": "jest tests/auth/validation.test.ts",
    "test:utils": "jest tests/auth/utils.test.ts",
    "test:middleware": "jest tests/auth/middleware.test.ts"
  },
  "keywords": [
    "citypulse",
    "backend",
    "api"
  ],
  "author": "Nevil Patel",
  "license": "MIT",
  "packageManager": "pnpm@10.10.0",
  "dependencies": {
    "@citypulse/shared": "workspace:*",
    "@prisma/client": "^6.15.0",
    "@types/cookie-parser": "^1.4.9",
    "bcryptjs": "^3.0.2",
    "cookie-parser": "^1.4.7",
    "cors": "^2.8.5",
    "express": "^5.1.0",
    "express-rate-limit": "^8.1.0",
    "express-validator": "^7.2.1",
    "helmet": "^8.1.0",
    "jsonwebtoken": "^9.0.2",
    "zod": "^4.1.5"
  },
  "devDependencies": {
    "@types/bcryptjs": "^3.0.0",
    "@types/cors": "^2.8.19",
    "@types/express": "^5.0.3",
    "@types/jest": "^30.0.0",
    "@types/jsonwebtoken": "^9.0.10",
    "@types/node": "^24.3.1",
    "@types/supertest": "^6.0.3",
    "jest": "^30.1.3",
    "prisma": "^6.15.0",
    "supertest": "^7.1.4",
    "ts-jest": "^29.4.1",
    "tsx": "^4.20.5",
    "typescript": "~5.8.3"
  }
