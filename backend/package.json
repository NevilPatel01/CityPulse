{
  "name": "@citypulse/backend",
  "version": "1.0.0",
  "description": "CityPulse backend API server",
  "main": "dist/index.js",
  "scripts": {
    "dev": "tsx watch src/index.ts",
    "build": "tsc",
    "start": "node dist/index.js",
    "lint": "pnpm exec tsc --noEmit",
    "lint:fix": "pnpm exec tsc --noEmit",
    "db:init": "tsx src/scripts/initDb.ts",
    "db:reset": "tsx src/scripts/reset-db.ts",
    "db:manage": "./sql/manage-database.sh",
    "db:init-docker": "./sql/manage-database.sh init",
    "db:reset-docker": "./sql/manage-database.sh reset",
    "db:reset-schema": "bash backend/sql/reset-and-seed-database.sh",
    "db:status": "./sql/manage-database.sh status",
    "test": "jest --testTimeout=600000",
    "test:watch": "jest --watch",
    "test:coverage": "jest --coverage --testTimeout=600000",
    "test:ci": "jest --ci --coverage --watchAll=false --testTimeout=600000",
    "test:auth": "jest src/tests/auth/",
    "test:auth:register": "jest auth-register-login",
    "test:auth:password": "jest auth-password-reset",
    "test:auth:token": "jest auth-token-management",
    "test:auth:google": "jest auth-google-health",
    "test:profile": "jest src/tests/profile/",
    "test:profile:complete": "jest profile-complete",
    "test:recommendations": "jest src/tests/recommendations/",
    "test:search": "jest src/tests/search/",
    "test:security": "jest src/tests/security/owasp-zap.test.ts --verbose",
    "test:security:coverage": "jest src/tests/security/owasp-zap.test.ts --coverage --verbose",
    "test:security:sqli": "jest src/tests/security/owasp-zap.test.ts -t 'SQL Injection'",
    "test:security:xss": "jest src/tests/security/owasp-zap.test.ts -t 'Cross-Site Scripting'",
    "test:security:headers": "jest src/tests/security/owasp-zap.test.ts -t 'HTTP Security Headers'",
    "test:companions": "jest src/tests/trips/trip-companions.test.ts --testTimeout=600000",
    "test:achievements": "jest src/tests/achievements/achievements.test.ts --testTimeout=600000",
    "test:trips": "jest src/tests/trips/ --testTimeout=600000",
    "test:all": "jest src/tests/",
    "test:clean": "psql $DATABASE_URL -c \"DELETE FROM users WHERE email LIKE '%test_%';\"",
    "security:audit": "pnpm audit --audit-level=high"
  },
  "keywords": [
    "citypulse",
    "backend",
    "api"
  ],
  "author": "Nevil Patel",
  "license": "MIT",
  "packageManager": "pnpm@10.10.0",
  "dependencies": {
    "@citypulse/shared": "workspace:*",
    "@types/cookie-parser": "^1.4.9",
    "bcryptjs": "^3.0.2",
    "cookie-parser": "^1.4.7",
    "cors": "^2.8.5",
    "dotenv": "^17.2.2",
    "express": "^5.1.0",
    "express-rate-limit": "^8.1.0",
    "express-validator": "^7.2.1",
    "helmet": "^8.1.0",
    "jsonwebtoken": "^9.0.2",
    "multer": "^2.0.2",
    "nodemailer": "^6.10.1",
    "pg": "^8.13.1",
    "sharp": "^0.34.4",
    "socket.io": "^4.8.1",
    "zod": "^4.1.5"
  },
  "devDependencies": {
    "@jest/globals": "^30.1.2",
    "@types/bcryptjs": "^3.0.0",
    "@types/cors": "^2.8.19",
    "@types/express": "^5.0.3",
    "@types/jest": "^30.0.0",
    "@types/jsonwebtoken": "^9.0.10",
    "@types/multer": "^2.0.0",
    "@types/node": "^24.3.1",
    "@types/nodemailer": "^6.4.19",
    "@types/pg": "^8.11.8",
    "@types/supertest": "^6.0.3",
    "jest": "^30.1.3",
    "supertest": "^7.1.4",
    "ts-jest": "^29.4.1",
    "tsx": "^4.20.5",
    "typescript": "~5.8.3"
  }
}
