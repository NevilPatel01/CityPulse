{
  "name": "@citypulse/backend",
  "version": "1.0.0",
  "description": "CityPulse backend API server",
  "main": "dist/index.js",
  "scripts": {
    "dev": "tsx watch src/index.ts",
    "build": "tsc",
    "start": "node dist/index.js",
    "lint": "pnpm exec tsc --noEmit",
    "lint:fix": "pnpm exec tsc --noEmit",
    "db:init": "tsx src/scripts/initDb.ts",
    "db:reset": "tsx src/scripts/reset-db.ts",
    "db:manage": "./sql/manage-database.sh",
    "db:init-docker": "./sql/manage-database.sh init",
    "db:reset-docker": "./sql/manage-database.sh reset",
    "db:reset-schema": "bash backend/sql/reset-and-seed-database.sh",
    "db:status": "./sql/manage-database.sh status",
    "test": "jest --testTimeout=600000",
    "test:watch": "jest --watch",
    "test:coverage": "jest --coverage --testTimeout=600000 --coverageReporters=text --coverageReporters=lcov --coverageReporters=html --coverageReporters=json-summary",
    "test:ci": "jest --ci --coverage --watchAll=false --testTimeout=600000",
    "test:coverage:html": "jest --coverage --testTimeout=600000 --coverageReporters=html && open coverage/index.html",
    "test:achievements": "jest src/tests/achievements/ --testTimeout=600000 --verbose",
    "test:api": "jest src/tests/api/ --testTimeout=600000 --verbose",
    "test:auth": "jest src/tests/auth/ --testTimeout=600000 --verbose",
    "test:buddies": "jest src/tests/buddies/ --testTimeout=600000 --verbose",
    "test:e2e": "jest src/tests/e2e/ --testTimeout=600000 --verbose",
    "test:feed": "jest src/tests/feed/ --testTimeout=600000 --verbose",
    "test:moderation": "jest src/tests/moderation/ --testTimeout=600000 --verbose",
    "test:notifications": "jest src/tests/notifications/ --testTimeout=600000 --verbose",
    "test:performance": "jest src/tests/performance/ --testTimeout=600000 --verbose",
    "test:profile": "jest src/tests/profile/ --testTimeout=600000 --verbose",
    "test:recommendations": "jest src/tests/recommendations/ --testTimeout=600000 --verbose",
    "test:search": "jest src/tests/search/ --testTimeout=600000 --verbose",
    "test:security": "jest src/tests/security/ --testTimeout=600000 --verbose",
    "test:social": "jest src/tests/social/ --testTimeout=600000 --verbose",
    "test:trips": "jest src/tests/trips/ --testTimeout=600000 --verbose",
    "test:all": "jest src/tests/ --testTimeout=600000 --verbose",
    "test:clean": "psql $DATABASE_URL -c \"DELETE FROM users WHERE email LIKE '%test_%';\"",
    "test:db:create": "tsx src/scripts/create-test-database.ts",
    "security:audit": "bash src/scripts/security-audit.sh",
    "security:deps": "pnpm audit --audit-level=high",
    "security:full": "pnpm test:security:all && pnpm security:deps",
    "penetration:test": "echo 'Penetration testing reports available in security-audit/ directory'"
  },
  "keywords": [
    "citypulse",
    "backend",
    "api"
  ],
  "author": "Nevil Patel",
  "license": "MIT",
  "packageManager": "pnpm@10.10.0",
  "dependencies": {
    "@types/cookie-parser": "^1.4.9",
    "bcryptjs": "^3.0.2",
    "cookie-parser": "^1.4.7",
    "cors": "^2.8.5",
    "dotenv": "^17.2.2",
    "express": "^5.1.0",
    "express-rate-limit": "^8.1.0",
    "express-validator": "^7.2.1",
    "helmet": "^8.1.0",
    "jsonwebtoken": "^9.0.2",
    "multer": "^2.0.2",
    "nodemailer": "^6.10.1",
    "pg": "^8.13.1",
    "sharp": "^0.34.4",
    "socket.io": "^4.8.1",
    "zod": "^4.1.5"
  },
  "devDependencies": {
    "@jest/globals": "^30.1.2",
    "@types/bcryptjs": "^3.0.0",
    "@types/cors": "^2.8.19",
    "@types/express": "^5.0.3",
    "@types/jest": "^29.5.14",
    "@types/jsonwebtoken": "^9.0.10",
    "@types/multer": "^2.0.0",
    "@types/node": "^24.3.1",
    "@types/nodemailer": "^6.4.19",
    "@types/pg": "^8.11.8",
    "@types/supertest": "^6.0.3",
    "jest": "^29.7.0",
    "supertest": "^7.1.4",
    "ts-jest": "^29.4.1",
    "tsx": "^4.20.5",
    "typescript": "~5.8.3"
  }
}
