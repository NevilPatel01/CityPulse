FROM node:20-alpine

RUN npm install -g pnpm@10.10.0 nodemon tsx

WORKDIR /workspace

COPY package.json pnpm-workspace.yaml pnpm-lock.yaml ./
COPY backend/package.json ./backend/package.json

RUN pnpm install --frozen-lockfile

# Copy source code with proper ownership
COPY --chown=node:node backend ./backend

# Create uploads directory with proper permissions before switching to node user
RUN mkdir -p /workspace/backend/uploads && chown -R node:node /workspace/backend/uploads

USER node

WORKDIR /workspace/backend

EXPOSE 5000

# Start with tsx for better TypeScript support
CMD ["pnpm", "run", "dev"]
